<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
               https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="IngoSOpenMindCultureTheme\Service\CrossSellerProvider">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Listing\ProductListingLoader"/>
        </service>

        <service id="IngoSOpenMindCultureTheme\Subscriber\CartCrossSellerSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="IngoSOpenMindCultureTheme\Subscriber\ErrorPageCrossSellerSubscriber">
            <argument type="service" id="YourPlugin\Service\CrossSellerProvider"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="IngoSOpenMindCultureTheme\Subscriber\SearchPageCrossSellerSubscriber">
            <argument type="service" id="YourPlugin\Service\CrossSellerProvider"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="IngoSOpenMindCultureTheme\Subscriber\ProductListingCategorySubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>

</container>