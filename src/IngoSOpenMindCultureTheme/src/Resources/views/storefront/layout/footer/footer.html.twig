{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}


{% block layout_footer_navigation %}
    <div class="ingos-footer-navigation-wrapper">

        {{ parent() }}
        <div class="has-borderless-links">

            <a href="{{ "ingos.openMindCultureTheme.imprintUrl"|trans }}">{{ "ingos.openMindCultureTheme.imprint"|trans }}</a> |
            <a href="{{ "ingos.openMindCultureTheme.paymentShippingUrl"|trans }}">{{ "ingos.openMindCultureTheme.paymentShipping"|trans }}</a> |
            <a href="{{ "ingos.openMindCultureTheme.withdrawalUrl"|trans }}">{{ "ingos.openMindCultureTheme.withdrawal"|trans }}</a> |
            <a href="{{ "ingos.openMindCultureTheme.privacyUrl"|trans }}">{{ "ingos.openMindCultureTheme.privacy"|trans }}</a> |
            <a href="{{ "ingos.openMindCultureTheme.blogUrl"|trans }}">{{ "ingos.openMindCultureTheme.blog"|trans }}</a>
        </div>
    </div>
{% endblock %}

{% block layout_footer_vat %}
    {% set cmsPath = 'frontend.cms.page.full' %}
    {% if showVatNotice or showVatNotice is not defined %}
        <div class="footer-vat">
            {% set shippingSnippetKey = context.taxState == 'gross' ? 'footer.includeVatTextPage' : 'footer.excludeVatTextPage' %}
            {% set shippingUrl = "ingos.openMindCultureTheme.paymentShippingUrl"|trans %}
            <p>
                {{ shippingSnippetKey|trans({
                    '%url%': shippingUrl,
                    '%star%': ''
                })|raw }}
            </p>
        </div>
    {% endif %}
{% endblock %}

{% block layout_footer_copyright %}
    <div class="footer-copyright-user">Copyright ©{{ "now"|date("Y") }} <a href="https://www.open-mind-culture.org"> Open Mind Culture</a> -
        <a href="https://www.ingo-steinke.de/" target="_blank">Ingo Steinke</a></div>
    {{ parent() }}
{% endblock %}

{% block layout_footer_navigation_information_content %}
{% endblock %}

{% block layout_footer_navigation_information_icons %}
{% endblock %}

{% block layout_footer_navigation_hotline %}
{% endblock %}

{% block layout_footer_payment_shipping_logos %}
{% endblock %}

{% block layout_footer_service_menu %}
{% endblock %}